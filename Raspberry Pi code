import cv2
from ultralytics import YOLO
import serial

# Arduino
arduino = serial.Serial('/dev/ttyACM0',9600)

# Camera
cap = cv2.VideoCapture(0)

# YOLO model
model = YOLO("yolov8n.pt")

while True:

    ret, frame = cap.read()

    if not ret:
        break

    results = model(frame)

    swimmer_count = 0

    for r in results:

        for box in r.boxes:

            cls = int(box.cls[0])

            # person class
            if cls == 0:

                swimmer_count += 1

                x1,y1,x2,y2 = map(int,box.xyxy[0])

                cv2.rectangle(frame,(x1,y1),(x2,y2),(0,255,0),2)

    cv2.putText(frame,
                f"Swimmers: {swimmer_count}",
                (20,40),
                cv2.FONT_HERSHEY_SIMPLEX,
                1,
                (255,0,0),
                2)

    if swimmer_count == 0:
        arduino.write(b'N')
    else:
        arduino.write(b'S')

    cv2.imshow("AquaWatch",frame)

    if cv2.waitKey(1)==27:
        break

cap.release()
